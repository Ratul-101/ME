  <circle cx="0" cy="286" r="9" fill="#78C0FF"/>
  <circle cx="430" cy="286" r="9" fill="#78C0FF"/>

  <g class="mono" fill="#7890A8" font-size="11" letter-spacing="1.5">
    <text x="0" y="-20">X0</text>
    <text x="430" y="-20" text-anchor="end">X430</text>
    <text x="-18" y="306">Y286</text>
  </g>

</g>

