  <text x="72" y="86">SYSTEM / 01</text>
  <text x="1528" y="86" text-anchor="end">MIE · CUET · BD</text>
  <text x="72" y="442">ENGINEERING × SOFTWARE × DATA × AI</text>
  <text x="1528" y="442" text-anchor="end">2026 / ACTIVE</text>
</g>

