<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="520" viewBox="0 0 1600 520">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#07090D"/>
    <stop offset=".55" stop-color="#0D1117"/>
    <stop offset="1" stop-color="#101A27"/>
  </linearGradient>

  <linearGradient id="signal" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#4DA3FF" stop-opacity="0"/>
    <stop offset=".25" stop-color="#4DA3FF"/>
    <stop offset=".75" stop-color="#78C0FF"/>
    <stop offset="1" stop-color="#4DA3FF" stop-opacity="0"/>
  </linearGradient>

  <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
    <path d="M48 0H0V48" fill="none" stroke="#B7C7D9" stroke-opacity=".055"/>
  </pattern>

  <filter id="glow">
    <feGaussianBlur stdDeviation="7" result="blur"/>
    <feMerge>
      <feMergeNode in="blur"/>
      <feMergeNode in="SourceGraphic"/>
    </feMerge>
  </filter>

  <style>
    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .sans {
      font-family: Arial, Helvetica, sans-serif;
    }
  </style>

</defs>

<!-- BASE -->

<rect width="1600" height="520" fill="url(#bg)"/>
<rect width="1600" height="520" fill="url(#grid)"/>

<!-- CROP MARKS -->

<g stroke="#DCE8F5" stroke-opacity=".35" stroke-width="2">
  <path d="M36 62h42M36 62v42"/>
  <path d="M1564 62h-42M1564 62v42"/>
  <path d="M36 458h42M36 458v-42"/>
  <path d="M1564 458h-42M1564 458v-42"/>
</g>

<!-- MICRO LABELS -->

